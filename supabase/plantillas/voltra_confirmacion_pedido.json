          [
            "Ana",
            "1 Tiras nasales",
            "129.000",
            "Calle Falsa 123",
            "Ciudad del Este"
          ]
        ]
      }
    },
    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "QUICK_REPLY",
          "text": "Confirmar"
        },
        {
          "type": "QUICK_REPLY",
          "text": "Corregir datos"
        },
        {
          "type": "QUICK_REPLY",
          "text": "Cancelar"
        }
      ]
    }
  ],
  "_notas": {
    "variables": [
      "nombre",
      "producto y cantidad",
      "total con envío, sin 'Gs'",
