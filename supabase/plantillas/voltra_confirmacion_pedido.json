{
  "name": "voltra_confirmacion_pedido",
  "language": "es",
  "category": "UTILITY",
  "components": [
    {
      "type": "BODY",
      "text": "Hola {{1}}, recibimos tu pedido de Voltra: {{2}}.\nTotal a pagar al recibir: Gs {{3}} (con envío de Gs 33.000).\nEntrega en {{4}}, {{5}}. ¿Confirmás los datos?",
      "example": {
